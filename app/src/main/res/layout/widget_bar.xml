<?xml version="1.0" encoding="utf-8"?>
<!-- Bar widget (4×1, TEK SATIR): sol kapak + başlık/sanatçı (ortayı doldurur, tek/iki satır)
     + prev·play·next sağda. Altta ince tam-genişlik progress. Dikey boşluk yok (1 satır hücre).
     Kapak/gövde dokun → app player'da açılır. Masaüstü MiniPlayer.kt yansıması. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- Ön-pişmiş zemin (blur+scrim+accent+yuvarlak köşe); hücre px'ine birebir -->
    <ImageView
        android:id="@+id/widget_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- İçerik: kapak | başlık/sanatçı (weight, ortayı doldurur) | kontroller -->
    <LinearLayout
        android:id="@+id/widget_bar_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_bar_cover"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_bar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_bar_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/widget_bar_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_prev"
                android:tint="#FFFFFFFF"
                android:contentDescription="@string/widget_cd_prev"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/widget_bar_playpause"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="13dp"
                android:background="@drawable/widget_play_bg"
                android:src="@drawable/ic_widget_play"
                android:tint="#FF0F0F14"
                android:contentDescription="@string/widget_cd_play_pause"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/widget_bar_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_next"
                android:tint="#FFFFFFFF"
                android:contentDescription="@string/widget_cd_next"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <!-- İnce non-interaktif progress: tam genişlik, en alt kenar -->
    <ProgressBar
        android:id="@+id/widget_bar_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="4dp"
        android:max="1000" />

    <!-- idle (hiç çalmadı / kuyruk boş): marka + CTA -->
    <LinearLayout
        android:id="@+id/widget_bar_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_idle_title"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_idle_cta"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Çevrimdışı rozeti -->
    <TextView
        android:id="@+id/widget_bar_offline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:background="#66000000"
        android:text="@string/widget_offline"
        android:textColor="#E6FFFFFF"
        android:textSize="9sp"
        android:visibility="gone" />
</FrameLayout>
