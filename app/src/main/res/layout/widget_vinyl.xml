<?xml version="1.0" encoding="utf-8"?>
<!-- Vinyl widget (2×2): ön-pişmiş blur zemin + STATİK disk (dönmez; kapak
     daireye kırpılı + oluk + accent label + orta delik baked-in) + merkez
     play/pause + köşe prev/next. Disk dokunulunca app açılır. Masaüstü
     MiniVinylWindow.kt yansıması. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_vinyl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/widget_vinyl_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- STATİK disk (kare bitmap, merkez) -->
    <ImageView
        android:id="@+id/widget_vinyl_disc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Transport: köşe prev/next + merkez play/pause -->
    <FrameLayout
        android:id="@+id/widget_vinyl_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/widget_vinyl_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="4dp"
            android:padding="11dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_widget_prev"
            android:tint="#FFFFFFFF"
            android:contentDescription="@string/widget_cd_prev"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/widget_vinyl_playpause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:padding="15dp"
            android:background="@drawable/widget_play_bg"
            android:src="@drawable/ic_widget_play"
            android:tint="#FF0F0F14"
            android:contentDescription="@string/widget_cd_play_pause"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/widget_vinyl_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:padding="11dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_widget_next"
            android:tint="#FFFFFFFF"
            android:contentDescription="@string/widget_cd_next"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- idle -->
    <LinearLayout
        android:id="@+id/widget_vinyl_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_idle_title"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="@string/widget_idle_cta"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_vinyl_offline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:background="#66000000"
        android:text="@string/widget_offline"
        android:textColor="#E6FFFFFF"
        android:textSize="9sp"
        android:visibility="gone" />
</FrameLayout>
